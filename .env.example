# ---- Environment configuration ----
# Copy to .env and fill in real values. NEVER commit .env

# PostgreSQL connection (local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chowheaven?schema=public"

# JWT signing secret — generate with: openssl rand -base64 48
AUTH_SECRET="dev-only-secret-change-me-please-0123456789abcdef"

# Public site URL (used for links in emails / OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Payments ----
# Demo mode simulates the payment provider flow. Set to "false" to require a real provider.
DEMO_MODE="true"
# Paystack integration (leave empty in demo mode)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Flutterwave integration (leave empty in demo mode)
FLUTTERWAVE_SECRET_KEY=""

# Timezone used for revenue "today" calculations
APP_TIMEZONE="Africa/Lagos"